# Normalize line endings: text files are stored and checked out with LF.
* text=auto eol=lf

# Windows scripts need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never diff or merge as text.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.jar  binary
*.pdf  binary

# Generated files: collapsed in GitHub diffs and left out of language stats.
pubspec.lock     linguist-generated=true
ios/Podfile.lock linguist-generated=true
*.g.dart         linguist-generated=true
*.freezed.dart   linguist-generated=true
